# =============================================================================
# DEBBY'S KITCHENWARE — environment configuration
# Copy this file to `.env` and replace every [PLACEHOLDER] with real values.
# `.env` is gitignored. NEVER commit real secrets.
# =============================================================================

# --- Database (Supabase / PostgreSQL) ----------------------------------------
# Supabase gives you THREE connection strings. Which one you use matters:
#
#   Direct (port 5432)              one real connection per client. Fine for
#                                   local work; on Vercel it runs out of
#                                   connections, because each serverless
#                                   invocation opens its own.
#   Session pooler (port 5432)      pooled, one connection per session.
#   Transaction pooler (port 6543)  pooled per statement. USE THIS on Vercel.
#
# Find them in Supabase: Project Settings -> Database -> Connection string.
# Pick "Transaction pooler", tick "Use connection pooling", and replace
# [YOUR-PASSWORD] with your database password.
#
# There is no local fallback. If this is unset the app and `db:push` both stop
# with an error, rather than quietly using a throwaway database — which has
# happened, and cost an afternoon of confusion.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Authentication ----------------------------------------------------------
# Generate with:  openssl rand -base64 48
# At least 32 characters. Server-side only — never exposed to the browser.
AUTH_SECRET="[GENERATE_A_LONG_RANDOM_SECRET]"

# --- Seeded admin account ----------------------------------------------------
# Used ONCE by `npm run db:seed` to create the first owner login.
# Change the password immediately after first sign-in.
SEED_ADMIN_EMAIL="owner@debbyskitchenware.co.ke"
SEED_ADMIN_PASSWORD="[CHOOSE_A_STRONG_PASSWORD]"
SEED_ADMIN_NAME="Debby"

# --- Business information (public — appears on the website) ------------------
NEXT_PUBLIC_BUSINESS_NAME="Debby's Kitchenware"
NEXT_PUBLIC_BUSINESS_SHORT_NAME="Debby's"
NEXT_PUBLIC_BUSINESS_TAGLINE="Kitchenware & household essentials"

# Phone shown on the site, in international format for tel: links.
NEXT_PUBLIC_BUSINESS_PHONE="[BUSINESS PHONE e.g. +254700000000]"

# WhatsApp number in FULL international format, digits only, no + and no spaces.
# Kenyan example: 0712345678 becomes 254712345678
NEXT_PUBLIC_BUSINESS_WHATSAPP="[WHATSAPP NUMBER e.g. 254700000000]"

NEXT_PUBLIC_BUSINESS_EMAIL="[BUSINESS EMAIL]"
NEXT_PUBLIC_BUSINESS_ADDRESS="[BUSINESS LOCATION — shop name, street, town]"
NEXT_PUBLIC_BUSINESS_CITY="[TOWN/CITY]"
NEXT_PUBLIC_BUSINESS_COUNTY="[COUNTY]"
NEXT_PUBLIC_BUSINESS_HOURS="[OPENING HOURS e.g. Mon-Sat 8:00am - 7:00pm]"

# Paste the share link from Google Maps for your shop. Leave blank to hide the
# map section entirely rather than show a wrong location.
NEXT_PUBLIC_GOOGLE_MAPS_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""

# --- Social (leave blank to hide the icon) -----------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""

# --- Payment instructions (public — shown at checkout) -----------------------
# Leave a value blank and that payment method is hidden from checkout.
NEXT_PUBLIC_MPESA_TILL="[M-PESA TILL NUMBER]"
NEXT_PUBLIC_MPESA_PAYBILL=""
NEXT_PUBLIC_MPESA_PAYBILL_ACCOUNT=""
NEXT_PUBLIC_MPESA_SEND_MONEY_NAME=""
NEXT_PUBLIC_ENABLE_CASH_ON_DELIVERY="true"
NEXT_PUBLIC_ENABLE_PAY_ON_PICKUP="true"

# --- M-Pesa Daraja (NOT IMPLEMENTED YET — see docs/TECHNICAL.md) -------------
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENVIRONMENT="sandbox"
MPESA_CALLBACK_URL=""

# --- Google sign-in (optional) -----------------------------------------------
# Leave both blank and the "Continue with Google" button is not shown at all.
#
# To enable it:
#   1. console.cloud.google.com -> create a project
#   2. APIs & Services -> OAuth consent screen -> External -> fill in the name,
#      your support email and the developer email. Publish it, or add yourself
#      as a Test user while you are still trying it out.
#   3. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      -> Web application
#   4. Authorised redirect URIs must list, exactly:
#         http://localhost:3000/api/auth/google/callback
#         https://YOUR-DOMAIN/api/auth/google/callback
#      A mismatch here is the single most common cause of redirect_uri_mismatch.
#   5. Copy the client ID and secret below, and into Vercel's environment
#      variables for production.
#
# The ID is safe to expose (the browser sends it to Google). The secret is not:
# it must never appear in NEXT_PUBLIC_ anything, in a commit, or in a message.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Analytics (optional — leave blank to disable) ---------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
